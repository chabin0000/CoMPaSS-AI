{
  "hosting": {
    "target": "argos",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {"source": "**", "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"}
      ]},
      {"source": "/assets/**", "headers": [{"key": "Cache-Control", "value": "public,max-age=31536000,immutable"}]},
      {"source": "/universe/**", "headers": [{"key": "Cache-Control", "value": "public,max-age=3600,must-revalidate"}]},
      {"source": "/sources/**", "headers": [{"key": "Cache-Control", "value": "public,max-age=0,must-revalidate"}]},
      {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  }
}
